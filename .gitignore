# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Written by `flutter create` along with the platform folders.
/.metadata

# android/ is committed (F-Droid and Play build from it; generated once with
# the pinned Flutter, its own .gitignore leaves out local and build files).
# The other platform folders are generated by `flutter create --empty --org
# com .`, the app icons in them by `dart run flutter_launcher_icons`. Only
# the few files GitMarker customises there are committed (flutter create
# never overwrites them): the plist and entitlements, and the runner files
# that carry the display name "GitMarker" (and the Linux window icon).
/ios/*
!/ios/Runner/
/ios/Runner/*
!/ios/Runner/Info.plist
/macos/*
!/macos/Runner/
/macos/Runner/*
!/macos/Runner/DebugProfile.entitlements
!/macos/Runner/Release.entitlements
!/macos/Runner/Configs/
/macos/Runner/Configs/*
!/macos/Runner/Configs/AppInfo.xcconfig
!/macos/Runner/Base.lproj/
/macos/Runner/Base.lproj/*
!/macos/Runner/Base.lproj/MainMenu.xib
/linux/*
!/linux/runner/
/linux/runner/*
!/linux/runner/my_application.cc
/windows/*
!/windows/runner/
/windows/runner/*
!/windows/runner/main.cpp
!/windows/runner/Runner.rc
/web/

